{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/main"
      ],
      "outFiles": [
        "${workspaceFolder}/main/out/**/*.js"
      ],
      "sourceMaps": true,
      "preLaunchTask": "compile"
    },
    {
      "name": "Run Extension (watch)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/main"
      ],
      "outFiles": [
        "${workspaceFolder}/main/out/**/*.js"
      ],
      "sourceMaps": true,
      "preLaunchTask": "watch"
    }
  ]
}
