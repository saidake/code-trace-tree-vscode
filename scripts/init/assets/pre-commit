#!/bin/sh
REPO_ROOT=$(git rev-parse --show-toplevel)

echo "🔍 Checking frontend code formatting..."

if ! command -v yarn >/dev/null 2>&1; then
    echo "❌ Yarn is not installed. Please install Yarn first."
    exit 1
fi

if ! yarn prettier --version >/dev/null 2>&1; then
    echo "❌ Prettier is not installed. Run 'yarn add -D prettier' in your project."
    exit 1
fi

yarn check-format

if [ $? -ne 0 ]; then
    echo "🚨 Code is not formatted. Run 'yarn format' before committing."
    exit 1
fi

echo "✅ Frontend code formatting is correct."
